package mcp

import (
    "math"
    "strings"
    . "martianoff/gala/test"
)

// outcome renders a parse result as the compact JSON on success, or the
// error message on failure, so one table can cover both.
func outcome(input string) string = ParseJson(input) match {
    case Success(v) => RenderJson(v)
    case Failure(e) => e.Error()
}

// outcomeIs asserts that parsing input has the outcome expected.
func outcomeIs(t T, input string, expected string) T = Eq(t, outcome(input), expected)

func nested(open string, close string, depth int) string =
    strings.Repeat(open, depth) + "0" + strings.Repeat(close, depth)

func TestParseStrings(t T) T =
    RunCases(t,
        outcomeIs,
        Case(Name = "raw emoji", Input = "\"😀\"", Expected = "\"😀\""),
        Case(Name = "surrogate pair", Input = "\"\\ud83d\\ude00\"", Expected = "\"😀\""),
        Case(Name = "upper-case pair", Input = "\"\\uD83D\\uDE00\"", Expected = "\"😀\""),
        Case(Name = "lone high", Input = "\"\\ud83d\"", Expected = "\"\uFFFD\""),
        Case(Name = "lone low", Input = "\"\\ude00\"", Expected = "\"\uFFFD\""),
        Case(Name = "high then text", Input = "\"\\ud83dx\"", Expected = "\"\uFFFDx\""),
        Case(Name = "high then non-surrogate", Input = "\"\\ud83d\\u0041\"", Expected = "\"\uFFFDA\""),
        Case(Name = "high, high, low", Input = "\"\\ud83d\\ud83d\\ude00\"", Expected = "\"\uFFFD😀\""),
        Case(Name = "low then high", Input = "\"\\ude00\\ud83d\"", Expected = "\"\uFFFD\uFFFD\""),
        Case(
            Name = "simple escapes",
            Input = "\"\\\" \\\\ \\/ \\b \\f \\n \\r \\t\"",
            Expected = "\"\\\" \\\\ / \\u0008 \\u000c \\n \\r \\t\"",
        ),
        Case(Name = "escaped control char", Input = "\"\\u0001\"", Expected = "\"\\u0001\""),
        Case(Name = "text around escapes", Input = "\"ab\\ncd\\u00e9ef\"", Expected = "\"ab\\ncdéef\""),
    )

func TestParseStructure(t T) T =
    RunCases(t,
        outcomeIs,
        Case(Name = "empty containers", Input = "[{},[]]", Expected = "[{},[]]"),
        Case(
            Name = "whitespace everywhere",
            Input = " \t{ \"a\" : [ 1 , 2 ] ,\r\n \"b\" : { } }\n",
            Expected = "{\"a\":[1,2],\"b\":{}}",
        ),
        Case(Name = "duplicate keys kept in order", Input = "{\"a\":1,\"a\":2}", Expected = "{\"a\":1,\"a\":2}"),
    )

func TestParseNumbers(t T) T =
    RunCases(t,
        outcomeIs,
        Case(Name = "zero", Input = "0", Expected = "0"),
        Case(Name = "negative zero", Input = "-0", Expected = "-0"),
        Case(Name = "fraction", Input = "1.5", Expected = "1.5"),
        Case(Name = "exponent", Input = "1e2", Expected = "100"),
        Case(Name = "upper-case negative exponent", Input = "1E-2", Expected = "0.01"),
        Case(Name = "signed exponent", Input = "-1.25e+3", Expected = "-1250"),
        Case(Name = "zero fraction", Input = "0.25", Expected = "0.25"),
        Case(Name = "large", Input = "1e21", Expected = "1e+21"),
        Case(Name = "small", Input = "1e-7", Expected = "1e-7"),
        Case(
            Name = "many digits",
            Input = "123456789012345678901234567890",
            Expected = "1.2345678901234568e+29",
        ),
        Case(Name = "underflow rounds to zero", Input = "1e-400", Expected = "0"),
        Case(Name = "largest float", Input = "1.7976931348623157e308", Expected = "1.7976931348623157e+308"),
    )

func TestParseRejects(t T) T =
    RunCases(t,
        outcomeIs,
        // Truncation always reads "unexpected end of input", at the input length.
        Case(Name = "empty", Input = "", Expected = "json: unexpected end of input at position 0"),
        Case(Name = "blank", Input = "   ", Expected = "json: unexpected end of input at position 3"),
        Case(Name = "open array", Input = "[1, 2", Expected = "json: unexpected end of input at position 5"),
        Case(Name = "open array after comma", Input = "[1,", Expected = "json: unexpected end of input at position 3"),
        Case(Name = "open object", Input = "{\"a\":1", Expected = "json: unexpected end of input at position 6"),
        Case(Name = "missing value", Input = "{\"a\":", Expected = "json: unexpected end of input at position 5"),
        Case(Name = "open string", Input = "\"abc", Expected = "json: unexpected end of input at position 4"),
        Case(Name = "open escape", Input = "\"a\\", Expected = "json: unexpected end of input at position 3"),
        Case(Name = "short \\u", Input = "\"\\u12", Expected = "json: unexpected end of input at position 5"),
        Case(Name = "short literal", Input = "tru", Expected = "json: unexpected end of input at position 3"),
        Case(Name = "minus only", Input = "-", Expected = "json: unexpected end of input at position 1"),
        Case(Name = "dot at end", Input = "1.", Expected = "json: unexpected end of input at position 2"),
        Case(Name = "e at end", Input = "1e", Expected = "json: unexpected end of input at position 2"),
        Case(Name = "e sign at end", Input = "1e+", Expected = "json: unexpected end of input at position 3"),
        // Structure: the position is the offending byte.
        Case(Name = "bare word", Input = "{bad", Expected = "json: expected string key, found 'b' at position 1"),
        Case(Name = "missing comma", Input = "[1 2]", Expected = "json: expected ',' or ']', found '2' at position 3"),
        Case(Name = "missing colon", Input = "{\"a\" 1}", Expected = "json: expected ':', found '1' at position 5"),
        Case(
            Name = "missing object comma",
            Input = "{\"a\":1 \"b\":2}",
            Expected = "json: expected ',' or '}', found '\"' at position 7",
        ),
        Case(Name = "trailing array comma", Input = "[1,]", Expected = "json: expected value, found ']' at position 3"),
        Case(Name = "trailing object comma", Input = "{\"a\":1,}", Expected = "json: expected string key, found '}' at position 7"),
        Case(Name = "bad literal", Input = "trux", Expected = "json: expected 'true', found 'x' at position 3"),
        Case(Name = "trailing data", Input = "1 2", Expected = "json: expected end of input, found '2' at position 2"),
        Case(Name = "non-ASCII byte", Input = "é", Expected = "json: expected value, found 0xc3 at position 0"),
        // Numbers follow RFC 8259: no '+', no leading zeros, digits on both sides of '.'.
        Case(Name = "plus sign", Input = "+1", Expected = "json: expected value, found '+' at position 0"),
        Case(Name = "leading zero", Input = "01", Expected = "json: expected end of input, found '1' at position 1"),
        Case(Name = "leading zero in array", Input = "[-01]", Expected = "json: expected ',' or ']', found '1' at position 3"),
        Case(Name = "bare fraction", Input = ".5", Expected = "json: expected value, found '.' at position 0"),
        Case(Name = "no fraction digits", Input = "1.e5", Expected = "json: expected digit, found 'e' at position 2"),
        Case(Name = "minus letter", Input = "-a", Expected = "json: expected digit, found 'a' at position 1"),
        Case(Name = "double minus", Input = "--1", Expected = "json: expected digit, found '-' at position 1"),
        Case(Name = "hex number", Input = "0x10", Expected = "json: expected end of input, found 'x' at position 1"),
        // float64 cannot hold these, and JsonValue never holds an infinity.
        Case(Name = "overflow", Input = "1e400", Expected = "json: number out of range at position 0"),
        Case(Name = "negative overflow", Input = "[-1e400]", Expected = "json: number out of range at position 1"),
        // Strings.
        Case(Name = "bad escape", Input = "\"a\\x\"", Expected = "json: invalid escape sequence at position 2"),
        Case(Name = "\\u plus sign", Input = "\"\\u+123\"", Expected = "json: expected hex digit, found '+' at position 3"),
        Case(Name = "\\u minus sign", Input = "\"\\u-123\"", Expected = "json: expected hex digit, found '-' at position 3"),
        Case(Name = "\\u short", Input = "\"\\u12\"", Expected = "json: expected hex digit, found '\"' at position 5"),
        Case(Name = "\\u non-hex", Input = "\"\\u00g0\"", Expected = "json: expected hex digit, found 'g' at position 5"),
        Case(
            Name = "bad escape after high surrogate",
            Input = "\"\\ud83d\\uzzzz\"",
            Expected = "json: expected hex digit, found 'z' at position 9",
        ),
        Case(Name = "raw NUL", Input = "\"a\u0000b\"", Expected = "json: unescaped control character 0x00 in string at position 2"),
        Case(Name = "raw tab", Input = "\"a\tb\"", Expected = "json: unescaped control character 0x09 in string at position 2"),
        Case(Name = "raw newline", Input = "\"a\nb\"", Expected = "json: unescaped control character 0x0a in string at position 2"),
        Case(Name = "raw unit separator", Input = "\"\u001f\"", Expected = "json: unescaped control character 0x1f in string at position 1"),
        Case(Name = "invalid UTF-8 byte", Input = "\"a\xffb\"", Expected = "json: invalid UTF-8 in string at position 2"),
        Case(Name = "truncated UTF-8", Input = "\"\xc3\"", Expected = "json: invalid UTF-8 in string at position 1"),
        Case(Name = "UTF-8 surrogate", Input = "\"\xed\xa0\x80\"", Expected = "json: invalid UTF-8 in string at position 1"),
        Case(Name = "overlong UTF-8", Input = "\"\xc0\xaf\"", Expected = "json: invalid UTF-8 in string at position 1"),
    )

func TestParseDepthLimit(t T) T =
    RunCases(t,
        outcomeIs,
        Case(
            Name = "arrays at the limit",
            Input = nested("[", "]", MaxJsonDepth),
            Expected = nested("[", "]", MaxJsonDepth),
        ),
        Case(
            Name = "arrays over the limit",
            Input = nested("[", "]", MaxJsonDepth + 1),
            Expected = "json: nesting deeper than 512 levels at position 512",
        ),
        Case(
            Name = "objects at the limit",
            Input = nested("{\"k\":", "}", MaxJsonDepth),
            Expected = nested("{\"k\":", "}", MaxJsonDepth),
        ),
        Case(
            Name = "objects over the limit",
            Input = nested("{\"k\":", "}", MaxJsonDepth + 1),
            Expected = "json: nesting deeper than 512 levels at position 2560",
        ),
        Case(
            Name = "mixed over the limit",
            Input = nested("[{\"k\":", "}]", MaxJsonDepth / 2 + 1),
            Expected = "json: nesting deeper than 512 levels at position 1536",
        ),
        Case(
            Name = "far over the limit",
            Input = nested("[", "]", 1000000),
            Expected = "json: nesting deeper than 512 levels at position 512",
        ),
    )

func TestParseErrorIsTyped(t T) T {
    val offset = ParseJson("[1, x]") match {
        case Failure(e: JsonSyntaxError) => e.Offset
        case _ => -1
    }
    Eq(t, offset, 4)
}

func TestRenderNumbers(t T) T =
    RunCases(t,
        (sub T, input float64, expected string) => Eq(sub, RenderJson(JNum(input)), expected),
        Case(Name = "integer", Input = 42.0, Expected = "42"),
        Case(Name = "fraction", Input = -2.5, Expected = "-2.5"),
        Case(Name = "negative zero", Input = math.Copysign(0, -1), Expected = "-0"),
        Case(Name = "plain below 1e21", Input = 1e20, Expected = "100000000000000000000"),
        Case(Name = "exponent from 1e21", Input = 1e21, Expected = "1e+21"),
        Case(Name = "plain from 1e-6", Input = 0.000001, Expected = "0.000001"),
        Case(Name = "exponent below 1e-6", Input = 1.5e-7, Expected = "1.5e-7"),
        Case(Name = "largest float", Input = math.MaxFloat64, Expected = "1.7976931348623157e+308"),
        Case(Name = "smallest float", Input = math.SmallestNonzeroFloat64, Expected = "5e-324"),
        // JSON has no NaN or Infinity: they render as null.
        Case(Name = "NaN", Input = math.NaN(), Expected = "null"),
        Case(Name = "+Inf", Input = math.Inf(1), Expected = "null"),
        Case(Name = "-Inf", Input = math.Inf(-1), Expected = "null"),
    )

func TestRenderStrings(t T) T =
    RunCases(t,
        (sub T, input string, expected string) => Eq(sub, RenderJson(JStr(input)), expected),
        Case(Name = "plain", Input = "hi", Expected = "\"hi\""),
        Case(Name = "quote and backslash", Input = "a\"b\\c", Expected = "\"a\\\"b\\\\c\""),
        Case(Name = "whitespace escapes", Input = "\n\r\t", Expected = "\"\\n\\r\\t\""),
        Case(Name = "control chars", Input = "\u0000\u001f", Expected = "\"\\u0000\\u001f\""),
        Case(Name = "emoji", Input = "😀", Expected = "\"😀\""),
        Case(Name = "invalid UTF-8", Input = "a\xffb", Expected = "\"a\uFFFDb\""),
    )

func TestRenderedOutputParses(t T) T {
    val v = JArrOf(JNum(math.NaN()), JNum(math.Inf(1)), JNum(1e300), JStr("a\xff"), JStr("\u0001"))
    IsSuccess(t, ParseJson(RenderJson(v)))
}
