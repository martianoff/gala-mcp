package mcp

import (
    "bufio"
    "bytes"
    "fmt"
    "io"
    "math"
    "os"
    "strconv"
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

// maxLine bounds a single newline-delimited JSON-RPC message (10 MiB). A
// longer line is answered with an invalid-request error and skipped.
val maxLine = 10 * 1024 * 1024

// readChunk is the size of the transport's read buffer; longer lines are
// read through it in chunks.
val readChunk = 64 * 1024

// tooLargeResponse answers a line longer than maxLine. The line is never
// parsed, so its id is unknown and the response carries a null one.
val tooLargeResponse = RenderJson(invalidRequest(
    JNull(),
    s"request exceeds the ${maxLine / (1024 * 1024)} MiB limit",
))

// Server is an MCP server runtime: server identity plus the registered tools.
// It speaks JSON-RPC 2.0 over newline-delimited stdio (the transport Claude
// Desktop / Claude Code use for local servers).
//
// Build one with NewServer, attach tools with WithTool, then call Run to
// serve over stdio. Server is immutable — WithTool returns a new value.
struct Server(
    Name    string,
    Version string,
    Tools   Array[Tool],
)

// NewServer creates an MCP server with no tools registered.
func NewServer(name string, version string) Server =
    Server(name, version, EmptyArray[Tool]())

// WithTool returns a copy of the server with one more tool registered.
func (s Server) WithTool(t Tool) Server = s.Copy(Tools = s.Tools.Append(t))

// Run serves JSON-RPC requests over stdin/stdout until stdin reaches EOF,
// then returns Success. Each line of input is one request; each response is
// written as one line. If reading stdin or writing stdout fails, the client
// is gone: Run logs the error to stderr, stops serving and returns it as a
// Failure.
func (s Server) Run() Try[Void] =
    s.serve(os.Stdin, os.Stdout).OnFailure((err) => {
        fmt.Fprintln(os.Stderr, s"mcp: stopped serving: ${strconv.Quote(err.Error())}")
    })

// serve is Run over an arbitrary reader and writer, without the logging.
func (s Server) serve(in io.Reader, out io.Writer) Try[Void] {
    val reader = bufio.NewReaderSize(in, readChunk)
    for {
        val next = s.step(readFrame(reader), out)
        next match {
            case Some(outcome) => { return outcome }
            case None() => {}
        }
    }
}

// step answers one frame of input, and returns the outcome of serving once
// serving must stop: at the end of the input, or when a write fails.
func (s Server) step(f frame, out io.Writer) Option[Try[Void]] = f match {
    case LineFrame(text) => s.HandleLine(text).FlatMap((resp) => writeLine(out, resp))
    case OversizedFrame() => writeLine(out, tooLargeResponse)
    case EndFrame(outcome) => Some(outcome)
}

// writeLine writes one response line to out. A failed write means the client
// is gone, so it returns that failure as the outcome of serving.
func writeLine(out io.Writer, line string) Option[Try[Void]] = fmt.Fprintln(out, line) match {
    case Failure(err) => Some(Failure[Void](err))
    case _ => None()
}

// frame is one unit of input read from the transport.
sealed type frame {
    case LineFrame(Text string)
    case OversizedFrame()
    case EndFrame(Outcome Try[Void])
}

// readFrame reads the next newline-delimited message from r. A line longer
// than maxLine is reported as OversizedFrame; it is skipped as it streams
// past, so no more than maxLine bytes of it are ever held. The end of the
// input is EndFrame with Success, and a read error is EndFrame with that
// error.
func readFrame(r *bufio.Reader) frame {
    val line = New[bytes.Buffer]()
    var size = 0
    for {
        val chunk, err = r.ReadSlice(byte('\n'))
        size = size + chunk.Size()
        // The newline itself is not part of the message.
        if (size <= maxLine + 1) {
            line.Write(chunk)
        }
        if (err != bufio.ErrBufferFull) {
            return endOfLine(line.String(), size, err)
        }
    }
}

// endOfLine classifies a line once reading it stopped with err (nil when the
// line ended at a newline). size counts every byte read, including the
// newline and any bytes skipped.
func endOfLine(text string, size int, err error) frame {
    val length = if (err == nil) size - 1 else size
    if (err != nil && err != io.EOF) {
        return EndFrame(Failure[Void](err))
    }
    if (length > maxLine) {
        return OversizedFrame()
    }
    if (size == 0) EndFrame(Success(Void())) else LineFrame(text)
}

// HandleLine processes a single raw input line and returns the response line
// to write back, or None when the input warrants no response (a blank line or
// a JSON-RPC notification). This is the core of the server and is what
// tests drive directly.
//
// A panic while handling the line — in a tool handler or in the server
// itself — is logged to stderr and answered with a JSON-RPC internal error
// (or with nothing, for a notification), and the server goes on to the next
// line.
func (s Server) HandleLine(line string) Option[string] {
    val trimmed = strings.TrimSpace(line)
    if trimmed == "" {
        return None[string]()
    }
    // A panic while parsing leaves the id unknown, which JSON-RPC 2.0 answers
    // with a null id.
    Try(ParseJson(trimmed)) match {
        case Success(Success(message)) => s.respond(message)
        case Success(Failure(_)) =>
            Some(RenderJson(errorResponse(JNull(), CodeParseError, "parse error")))
        case Failure(err) => internalError(Some(JNull()), err)
    }
}

// respond answers a parsed message inside the per-request panic boundary.
func (s Server) respond(message JsonValue) Option[string] =
    Try(s.answer(message)) match {
        case Success(resp) => resp
        case Failure(err) => internalError(replyId(message), err)
    }

// answer validates a message and carries it out. A notification is carried
// out like any request, but its response, success or error, is dropped.
func (s Server) answer(message JsonValue) Option[string] = parseRequest(message) match {
    case Left(rejection) => Some(RenderJson(rejection))
    case Right(req) => {
        val resp = s.dispatch(req)
        req.Id.Map((_) => RenderJson(resp))
    }
}

// internalError logs a panic raised while handling a request to stderr and
// answers it with a JSON-RPC internal error for id — or with nothing when id
// is None, since a notification never gets a response. The panic value is
// not sent to the client.
func internalError(id Option[JsonValue], err error) Option[string] {
    fmt.Fprintln(os.Stderr, s"mcp: request handling panicked: ${strconv.Quote(err.Error())}")
    id.Map((i) => RenderJson(errorResponse(i, CodeInternalError, "internal error")))
}

// request is a valid JSON-RPC 2.0 Request object. Id is None for a
// notification. Params is an object or an array, and an empty object when
// the request has none.
struct request(Id Option[JsonValue], Method string, Params JsonValue)

// parseRequest checks that message is a valid Request object, or returns
// the -32600 invalid-request response that rejects it. MCP has no batches,
// so an array is rejected as a whole.
func parseRequest(message JsonValue) Either[JsonValue, request] = message match {
    case JObj(_) => checkRequest(message)
    case JArr(_) => Left(invalidRequest(JNull(), "batch requests are not supported"))
    case _ => Left(invalidRequest(JNull(), "request must be a JSON object"))
}

// invalidRequest is the -32600 response rejecting a message for reason.
func invalidRequest(id JsonValue, reason string) JsonValue = errorResponse(id, CodeInvalidRequest, reason)

// checkRequest validates the members of a Request object.
func checkRequest(message JsonValue) Either[JsonValue, request] {
    val id = message.Get("id")
    val params = message.Get("params").GetOrElse(JObjOf())
    val reject = (reason string) => Left[JsonValue, request](
        invalidRequest(replyId(message).GetOrElse(JNull()), reason),
    )
    message.GetString("method") match {
        case _ if !id.Map(isValidId).GetOrElse(true) => reject("id must be a string or an integer")
        case _ if message.GetString("jsonrpc").GetOrElse("") != "2.0" =>
            reject("jsonrpc must be \"2.0\"")
        case None => reject("method must be a string")
        case _ if !isStructured(params) => reject("params must be an object or an array")
        case Some(method) => Right(request(id, method, params))
    }
}

// replyId is the id a response to message carries: the message's own id when
// it is valid, null when it is not, and None — no response at all — when the
// message has none.
func replyId(message JsonValue) Option[JsonValue] =
    message.Get("id").Map((id) => if (isValidId(id)) id else JNull())

// isValidId reports whether id is a valid MCP request id: a string or an
// integer. Unlike plain JSON-RPC 2.0, MCP does not allow a null id.
func isValidId(id JsonValue) bool = id match {
    case JStr(_) => true
    case JNum(n) => n == math.Trunc(n)
    case _ => false
}

// isStructured reports whether v may be a request's params: an object or an
// array.
func isStructured(v JsonValue) bool = v match {
    case JObj(_) => true
    case JArr(_) => true
    case _ => false
}

// dispatch routes a valid request to its handler and builds the response.
// For a notification the caller drops it.
func (s Server) dispatch(req request) JsonValue {
    val id = req.Id.GetOrElse(JNull())
    req.Method match {
        case "initialize" => successResponse(id, s.initializeResult())
        case "tools/list" => successResponse(id, s.toolsListResult())
        case "tools/call" => s.handleToolCall(id, req.Params)
        case "ping" => successResponse(id, JObjOf())
        case method => errorResponse(id, CodeMethodNotFound, s"method not found: $method")
    }
}

// initializeResult reports protocol version, capabilities and identity.
func (s Server) initializeResult() JsonValue =
    JObjOf(
        JField("protocolVersion", JStr(ProtocolVersion)),
        JField("capabilities", JObjOf(
            JField("tools", JObjOf()),
        )),
        JField("serverInfo", JObjOf(
            JField("name", JStr(s.Name)),
            JField("version", JStr(s.Version)),
        )),
    )

// toolsListResult advertises every registered tool and its input schema.
func (s Server) toolsListResult() JsonValue =
    JObjOf(
        JField("tools", JArr(s.Tools.Map(toolDescriptor))),
    )

func toolDescriptor(t Tool) JsonValue =
    JObjOf(
        JField("name", JStr(t.Name)),
        JField("description", JStr(t.Description)),
        JField("inputSchema", t.InputSchema),
    )

// handleToolCall validates params, finds the tool and runs it.
func (s Server) handleToolCall(id JsonValue, params JsonValue) JsonValue =
    params.GetString("name") match {
        case Some(name) => {
            val args = params.Get("arguments").GetOrElse(JObjOf())
            s.Tools.Find((t) => t.Name == name) match {
                case Some(tool) => successResponse(id, runTool(tool, args))
                case _ => errorResponse(id, CodeMethodNotFound, s"unknown tool: $name")
            }
        }
        case _ => errorResponse(id, CodeInvalidParams, "missing tool name")
    }

// runTool invokes a tool handler and wraps its output in the MCP
// CallToolResult shape: a single text content block plus the isError flag.
// A handler that panics is handled by HandleLine's per-request boundary.
func runTool(tool Tool, args JsonValue) JsonValue {
    val result = tool.Handler(args)
    return JObjOf(
        JField("content", JArrOf(
            JObjOf(
                JField("type", JStr("text")),
                JField("text", JStr(result.Text)),
            ),
        )),
        JField("isError", JBool(result.IsError)),
    )
}
